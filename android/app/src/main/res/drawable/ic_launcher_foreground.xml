<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Daybreak: a luminous orb rising over a dark planet limb, lit by a white horizon arc. -->
    <group>
        <!-- Halo around the orb. -->
        <path android:pathData="M19,51 A35,35 0 1,1 89,51 A35,35 0 1,1 19,51 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="54" android:centerY="51" android:gradientRadius="35">
                    <item android:offset="0" android:color="#997B6CFF" />
                    <item android:offset="0.5" android:color="#807B6CFF" />
                    <item android:offset="0.72" android:color="#40C86DD7" />
                    <item android:offset="1" android:color="#00C86DD7" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <!-- Warm dawn light spread along the horizon (the planet hides its lower half). -->
    <group android:pivotX="54" android:pivotY="63.5" android:scaleY="0.3">
        <path android:pathData="M10,63.5 A44,44 0 1,1 98,63.5 A44,44 0 1,1 10,63.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="54" android:centerY="63.5" android:gradientRadius="44">
                    <item android:offset="0" android:color="#B3FF8A6B" />
                    <item android:offset="0.4" android:color="#59C86DD7" />
                    <item android:offset="1" android:color="#007B6CFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <group>
        <!-- Planet. -->
        <path android:pathData="M-38,155.5 A92,92 0 1,1 146,155.5 A92,92 0 1,1 -38,155.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="54" android:startY="63.5" android:endX="54" android:endY="89.5">
                    <item android:offset="0" android:color="#FF15132B" />
                    <item android:offset="1" android:color="#FF0B0B12" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Orb: the Daybreak gradient, cool above and warm where it meets the horizon. -->
        <path android:pathData="M42.53,64.22 A17.5,17.5 0 1,1 65.47,64.22 A92,92 0 0,0 42.53,64.22 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="54" android:startY="33.5" android:endX="54" android:endY="64.22">
                    <item android:offset="0" android:color="#FF7B6CFF" />
                    <item android:offset="0.45" android:color="#FFC86DD7" />
                    <item android:offset="0.78" android:color="#FFFF8A6B" />
                    <item android:offset="1" android:color="#FFFFC46B" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M42.53,64.22 A17.5,17.5 0 1,1 65.47,64.22 A92,92 0 0,0 42.53,64.22 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="63.62" android:centerY="47.5" android:gradientRadius="15.75">
                    <item android:offset="0" android:color="#66C86DD7" />
                    <item android:offset="1" android:color="#00C86DD7" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M42.53,64.22 A17.5,17.5 0 1,1 65.47,64.22 A92,92 0 0,0 42.53,64.22 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="54" android:centerY="65.22" android:gradientRadius="16.62">
                    <item android:offset="0" android:color="#CCFFE2A8" />
                    <item android:offset="0.45" android:color="#66FFC46B" />
                    <item android:offset="1" android:color="#00FFC46B" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M42.53,64.22 A17.5,17.5 0 1,1 65.47,64.22 A92,92 0 0,0 42.53,64.22 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="47.35" android:centerY="43.12" android:gradientRadius="13.12">
                    <item android:offset="0" android:color="#73FFFFFF" />
                    <item android:offset="0.5" android:color="#1FFFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Horizon arc, brightest under the orb. -->
        <path
            android:pathData="M20,70.01 A92,92 0 0,1 88,70.01"
            android:strokeWidth="1.6"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="20" android:startY="70.01" android:endX="88" android:endY="70.01">
                    <item android:offset="0" android:color="#00FFFFFF" />
                    <item android:offset="0.3" android:color="#8CFFFFFF" />
                    <item android:offset="0.5" android:color="#FFFFFFFF" />
                    <item android:offset="0.7" android:color="#8CFFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
