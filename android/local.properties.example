# Copy this file to local.properties and fill in the values.
# local.properties is gitignored — never commit credentials.
#
# Both values come from https://console.mimik.com (free developer signup):
#   1. Client ID          — your project page
#   2. Developer ID Token — "Get ID Token" button on your project page (it expires after about a month)
# The Edge License JWT (bottom of the Edge Projects page) goes in
# app/src/main/res/raw/mimoe_license, which is gitignored too.

# Where the Android SDK lives (Android Studio fills this in for you).
sdk.dir=/path/to/Android/sdk

# mimik developer console credentials
mimik.clientId=
mimik.developerIdToken=
